ehl(a,b){var s
A.Q(b,B.v,t.J).toString
switch(a.a){case 0:s="1. Visp\u0101r\u012bgie jaut\u0101jumi"
break
case 1:s="2. Darba uzs\u0101k\u0161ana ar E-klasi"
break
case 2:s="3. Izmantojot E-klasi, Lietot\u0101js ap\u0146emas iev\u0113rot \u0161\u0101dus galvenos noteikumus:"
break
case 3:s="4. Sarakste E-klas\u0113"
break
